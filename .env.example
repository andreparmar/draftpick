# Copy this file to .env and fill it in, or let the Chrome extension fill it
# for you (see README). Never commit .env: the cookies below are your ESPN login.

# Your ESPN league URL, or just the number after leagueId=
LEAGUE_ID=

# Private league? (most are) Easiest: the Chrome extension.
# By hand: Chrome → espn.com, logged in → ⌥⌘I → Application → Cookies → https://fantasy.espn.com
ESPN_S2=
SWID=

# Claude key from console.anthropic.com → API Keys (optional; math still works without it)
ANTHROPIC_API_KEY=

# Optional overrides
# DRAFT_MODEL=claude-sonnet-5-5   # sharper (pricier) takes; default is claude-haiku-4-5
# TEAM_ID=                        # detected automatically from SWID
# SEASON=2026
# PORT=8765                       # the extension expects 8765; change only if you won't use it
