{
  "manifest_version": 3,
  "name": "Draftpick Connector",
  "version": "1.1.0",
  "description": "Grabs your ESPN fantasy league id + login cookies and hands them to draftpick.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.espn.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Draftpick"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*draft*"
      ],
      "js": [
        "draftws-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://fantasy.espn.com/*draft*"
      ],
      "js": [
        "draftws-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}